# OwnTracks fan-out: every request goes to PROD (its response is returned to the
# phone) and a fire-and-forget copy goes to DEV (its response is discarded).
# PROD_URL and DEV_URL are full ingest URLs; the incoming path is replaced by
# theirs and only the query string is carried over.
# ${PROD_URL}, ${DEV_URL} and ${RESOLVER} are filled in from the environment at
# container start by the nginx image's envsubst step.

# Upstreams are resolved per request, so a DEV that is down or not yet in DNS
# never stops nginx from starting.
resolver ${RESOLVER} valid=30s ipv6=off;

server {
    listen 8080;
    client_max_body_size 10m;

    location / {
        mirror /__dev_mirror;
        mirror_request_body on;

        set $prod_upstream ${PROD_URL};
        proxy_pass $prod_upstream$is_args$args;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /__dev_mirror {
        internal;

        set $dev_upstream ${DEV_URL};
        proxy_pass $dev_upstream$is_args$args;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Keep a slow or dead DEV from holding the phone's connection open.
        proxy_connect_timeout 3s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
    }
}
