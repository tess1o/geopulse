# OwnTracks fan-out: PROD responds to the phone. DEV and optional THIRD get
# copies. Each target uses its configured ingest path and the incoming query.
# The nginx image fills in the URLs and resolver from the environment at startup.

# Upstream DNS is resolved at request time so a missing target cannot block startup.
resolver ${RESOLVER} valid=30s ipv6=off;

server {
    listen 8080;
    client_max_body_size 10m;

    location / {
        mirror /__dev_mirror;
        mirror /__third_mirror;
        mirror_request_body on;

        set $prod_upstream ${PROD_URL};
        proxy_pass $prod_upstream$is_args$args;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /__dev_mirror {
        internal;

        set $dev_upstream ${DEV_URL};
        proxy_pass $dev_upstream$is_args$args;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Keep a slow or dead DEV from holding the phone's connection open.
        proxy_connect_timeout 3s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
    }

    location = /__third_mirror {
        internal;

        set $third_upstream "${THIRD_URL}";
        if ($third_upstream = "") {
            return 204;
        }

        proxy_pass $third_upstream$is_args$args;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
    }
}
