{
  "name": "geopulse-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for GeoPulse application",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "setup:db": "node setup/database-setup.js",
    "validate:isolation": "node scripts/validate-isolated-specs.js"
  },
  "dependencies": {
    "@playwright/test": "1.64.0",
    "faker": "5.5.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "dotenv": "16.6.1"
  }
}
