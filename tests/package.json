{
  "name": "geopulse-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for GeoPulse application",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "setup:db": "node setup/database-setup.js",
    "validate:backend-logs": "node scripts/validate-backend-logs.js",
    "test:backend-logs": "node --test scripts/validate-backend-logs.test.js",
    "validate:isolation": "node scripts/validate-isolated-specs.js"
  },
  "dependencies": {
    "@playwright/test": "1.65.1",
    "faker": "6.6.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "dotenv": "18.0.10"
  }
}
